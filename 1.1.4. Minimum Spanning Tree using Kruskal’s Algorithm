#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

void kruskalMST(int **cost, int V) {
    int parent[V];
    int rank[V];

    for (int i = 0; i < V; i++) {
        parent[i] = i;
        rank[i] = 0;
    }

    int (*find)(int) = NULL;

    int edgeCount = 0;
    int totalCost = 0;

    while (edgeCount < V - 1) {
        int minWeight = INT_MAX;
        int minU = -1;
        int minW = -1;

        for (int i = 0; i < V; i++) {
            for (int j = i + 1; j < V; j++) {
                if (cost[i][j] < minWeight) {

                    if (cost[i][j] != 9999) {
                        minWeight = cost[i][j];
                        minU = i;
                        minW = j;
                    }
                }
            }
        }

        if (minU == -1)
            break;

        int rootU = minU;
        while (parent[rootU] != rootU)
            rootU = parent[rootU];

        int rootW = minW;
        while (parent[rootW] != rootW)
            rootW = parent[rootW];

        if (rootU != rootW) {
            printf("Edge %d:(%d, %d) cost:%d\n",
                   edgeCount, minU, minW, minWeight);

            totalCost += minWeight;
            edgeCount++;

            if (rank[rootU] < rank[rootW]) {
                parent[rootU] = rootW;
            } else if (rank[rootU] > rank[rootW]) {
                parent[rootW] = rootU;
            } else {
                parent[rootW] = rootU;
                rank[rootU]++;
            }
        }

        cost[minU][minW] = 9999;
    }

    printf("Minimum cost= %d\n", totalCost);
}


int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
