#include <stdio.h>

int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int n, capacity;

    scanf("%d", &n);

    int value[n], weight[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &value[i]);
    }

    for (int i = 0; i < n; i++) {
        scanf("%d", &weight[i]);
    }

    scanf("%d", &capacity);

    int dp[capacity + 1];

    for (int i = 0; i <= capacity; i++) {
        dp[i] = 0;
    }


    for (int i = 0; i < n; i++) {

        for (int w = capacity; w >= weight[i]; w--) {
            dp[w] = max(dp[w], dp[w - weight[i]] + value[i]);
        }
    }

    printf("%d\n", dp[capacity]);

    return 0;
}

